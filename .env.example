# PhyMaC Pipeline — Environment Variables
# Copy this to .env and fill in your values
# Never commit .env to git

# ─── Storage ──────────────────────────────────────────────
STORAGE_PROVIDER=r2          # "r2" (Cloudflare) or "s3" (AWS)

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_KEY=your_secret_key_here
R2_BUCKET_NAME=phymac-pipeline

# AWS S3 (only needed if STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=phymac-pipeline

# ─── Modal.com (GPU compute) ──────────────────────────────
# Get these from: https://modal.com/settings/tokens
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret

# ─── AI APIs ──────────────────────────────────────────────
# OpenRouter is the unified LLM gateway — one key for Claude, GPT, Gemini, etc.
# Get yours at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-...

# ElevenLabs for TTS (voice-over in podcast format)
ELEVENLABS_API_KEY=...

# ─── LLM models (optional — defaults are FREE for testing) ───
# Override these to use paid models in production
# LLM_MODEL_PLANNER=anthropic/claude-sonnet-4.5
# LLM_MODEL_VALIDATOR=anthropic/claude-haiku-4.5
# LLM_MODEL_VISION=anthropic/claude-sonnet-4.5

# ─── Pipeline config (optional, defaults are fine) ────────
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=es
DEFAULT_BRAND_ID=phymac
MAX_PHASE_RETRIES=3
VALIDATION_PASS_SCORE=0.6

# ─── OpenRouter dashboard metadata (optional) ──────────────
OPENROUTER_APP_NAME=phymac-pipeline
# OPENROUTER_SITE_URL=https://yourdomain.com
